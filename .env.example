# Settings for main.py. Copy this file to .env (git-ignored) and fill it in:  cp .env.example .env
# Leave both empty to use Ollama on this Mac instead.

# Ollama on JupyterHub, e.g. https://<hub address>/user/<your username>/proxy/11434
OLLAMA_URL=

# API token from https://<hub address>/hub/token. Never commit it or paste it into code.
JUPYTERHUB_TOKEN=
